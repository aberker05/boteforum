# ============================================================================
# 1. VERİTABANI BAĞLANTISI (Yerel SQLite veya Canlı Supabase PostgreSQL)
# ============================================================================
# Yerel geliştirme (SQLite):
DATABASE_URL="file:./dev.db"

# Canlı ortam (Supabase PostgreSQL - Project Settings -> Database -> Connection String):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# 2. OTURUM VE UYGULAMA GÜVENLİĞİ
# ============================================================================
# Canlı ortamda en az 32 karakterlik rastgele bir gizli anahtar girin:
JWT_SECRET="novaforum-production-secret-key-change-me-2026"

# Canlı ortamda kendi alan adınızı yazın (örn: https://novaforum.vercel.app):
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# 3. E-POSTA GÖNDERİMİ - ŞİFREMİ UNUTTUM KODU İÇİN (Gmail SMTP)
# ============================================================================
# Google Hesabınız -> Güvenlik -> 2 Adımlı Doğrulama -> Uygulama Şifreleri (App Passwords)
# kısmından aldığınız 16 haneli şifreyi SMTP_PASS içine yazın:
SMTP_USER="sizinadresiniz@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# ============================================================================
# 4. GOOGLE OAUTH 2.0 (İsteğe Bağlı)
# ============================================================================
# Google Cloud Console -> Credentials -> Authorized redirect URIs:
# https://alanadiniz.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
